# Keep audited references byte-exact; never normalize the source fingerprints.
/design_reference/** -text
/archive/sonic_gallery/** -text
/assets/icons/yymusic/*.svg text eol=lf
/docs/** text eol=lf
/tools/*.mjs text eol=lf
/tools/*.ps1 text eol=lf
/tools/*.gradle text eol=lf
/assets/legal/**/*.json text eol=lf
/README.md text eol=lf
/CHANGELOG.md text eol=lf
/.gitattributes text eol=lf
/.gitignore text eol=lf
/lib/** text eol=lf
/test/** text eol=lf
# Asset exceptions must follow the broad test-source rule above.
/test/golden/baselines/*.png binary
/assets/fonts/**/*.ttf binary
# Preserve upstream license bytes, including their original trailing spaces.
/assets/fonts/**/OFL.txt -text whitespace=-blank-at-eol
/assets/fonts/manifest.json text eol=lf
/dart_test.yaml text eol=lf
/.github/** text eol=lf
/pubspec.yaml text eol=lf
/pubspec.lock text eol=lf
/analysis_options.yaml text eol=lf
